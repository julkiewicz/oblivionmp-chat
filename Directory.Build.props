<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- The OblivionMP SDK packages every project builds against -->
        <OblivionSdkVersion>1.0.0-rc.3</OblivionSdkVersion>

        <!-- The chat NuGet packages, ReadyM.Oblivion.Chat.Client and .Server -->
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>rc.3</VersionSuffix>
        <Authors>ReadyCode Limited</Authors>
        <Company>ReadyCode Limited</Company>
        <PackageTags>oblivion;oblivionmp;readym;modding;multiplayer;chat</PackageTags>
        <PackageProjectUrl>https://obmp.readym.io</PackageProjectUrl>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
