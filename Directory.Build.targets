<Project>

    <!--
        The two chat packages each carry OblivionMp.ChatMod.Common.dll alongside their own assembly, rather than
        depending on a third package for it. A mod references only the half it is building, and the shared chat
        types have to come with it.
    -->
    <Target Name="PackChatCommon" Condition="'$(IsPackable)' == 'true'" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <_ChatCommon Include="@(ReferenceCopyLocalPaths)"
                         Condition="'%(Filename)' == 'OblivionMp.ChatMod.Common' and '%(Extension)' == '.dll'" />
            <!-- A project reference's doc file is not among the copied references; it sits next to the assembly -->
            <_ChatCommonDocs Include="@(_ChatCommon->'%(RootDir)%(Directory)%(Filename).xml')" />
            <BuildOutputInPackage Include="@(_ChatCommon)" />
            <BuildOutputInPackage Include="@(_ChatCommonDocs)" Condition="Exists('%(FullPath)')" />
        </ItemGroup>
    </Target>

    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackChatCommon</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

</Project>
