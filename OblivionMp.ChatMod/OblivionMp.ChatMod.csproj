<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>OblivionMp.ChatMod</RootNamespace>

        <IsPackable>true</IsPackable>
        <PackageId>ReadyM.Oblivion.Chat.Client</PackageId>
        <Title>OblivionMP chat, client</Title>
        <Description>The client API of the OblivionMP chat mod: show local lines, send as the player, open and close the overlay. For a client mod that lists the chat mod as a dependency.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ReadyM.SDK.Oblivion.Client" Version="$(OblivionSdkVersion)" />
    </ItemGroup>

    <!-- Packed into this package rather than depended on, see Directory.Build.targets -->
    <ItemGroup>
        <ProjectReference Include="..\OblivionMp.ChatMod.Common\OblivionMp.ChatMod.Common.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Update="web\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
